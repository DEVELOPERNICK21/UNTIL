+/**
+ * Event names kept apart from the main list so analytics.ts stays within its line limit;
+ * AnalyticsEventName includes ExtraEventName.
+ *
+ * - session_start_app   { session_index, days_since_install }   A new session began (cold start,
+ *                       or back after 30+ minutes in the background). `app_open` still fires on
+ *                       every foreground and is telemetry only.
+ * - widget_inventory    { widget_count, widget_types, platform }   Widget kinds on the home screen
+ *                       (a kind counts once however many of it are placed). Logged when it changes.
+ * - widget_stale        { hours_stale, manufacturer }   Android: hours since the background
+ *                       refresh last ran, logged at app open when a widget exists and it is 3h+.
+ * - notification_opened { type, source }   A notification was tapped (type: retention, winback,
+ *                       task, streak, trial, day2, other).
+ */
+import type { PaywallEventName } from './paywallEvents';
+
+export type MeasurementEventName =
+  | 'session_start_app'
+  | 'widget_inventory'
+  | 'widget_stale'
+  | 'notification_opened';
+
+export type ExtraEventName = PaywallEventName | MeasurementEventName;
diff --git a/src/shared/analytics/firebaseAnalytics.ts b/src/shared/analytics/firebaseAnalytics.ts
new file mode 100644
index 0000000..904a0aa
--- /dev/null
+++ b/src/shared/analytics/firebaseAnalytics.ts
@@ -0,0 +1,57 @@
+/**
+ * Firebase Analytics accessor, loaded lazily so a build without Firebase configured (local dev,
+ * tests) gets null instead of a crash. Moved out of analytics.ts, which is over its line limit.
+ */
+
+export type FirebaseAnalyticsModule = {
+  logEvent: (
+    name: string,
+    params?: Record<string, string | number>,
+  ) => Promise<void>;
+  setCollectionEnabled: (enabled: boolean) => Promise<void>;
+  setUserProperties: (properties: Record<string, string | null>) => Promise<void>;
+  setUserId: (id: string | null) => Promise<void>;
+};
+
+export function getAnalyticsModule(): FirebaseAnalyticsModule | null {
+  try {
+    const { getApp, getApps } = require('@react-native-firebase/app') as {
+      getApp: () => unknown;
+      getApps: () => unknown[];
+    };
+    if (getApps().length === 0) return null;
+    const {
+      getAnalytics,
+      logEvent,
+      setAnalyticsCollectionEnabled,
+      setUserProperties,
+      setUserId,
+    } = require('@react-native-firebase/analytics') as {
+      getAnalytics: (app: unknown) => unknown;
+      logEvent: (
+        analytics: unknown,
+        name: string,
+        params?: Record<string, string | number>,
+      ) => Promise<void>;
+      setAnalyticsCollectionEnabled: (
+        analytics: unknown,
+        enabled: boolean,
+      ) => Promise<void>;
+      setUserProperties: (
+        analytics: unknown,
+        properties: Record<string, string | null>,
+      ) => Promise<void>;
+      setUserId: (analytics: unknown, id: string | null) => Promise<void>;
+    };
+    const instance = getAnalytics(getApp());
+    return {
+      logEvent: (name, params) => logEvent(instance, name, params),
+      setCollectionEnabled: enabled =>
+        setAnalyticsCollectionEnabled(instance, enabled),
+      setUserProperties: properties => setUserProperties(instance, properties),
+      setUserId: id => setUserId(instance, id),
+    };
+  } catch {
+    return null;
+  }
+}
diff --git a/src/shared/analytics/firebaseUserProperties.ts b/src/shared/analytics/firebaseUserProperties.ts
new file mode 100644
index 0000000..9466047
--- /dev/null
+++ b/src/shared/analytics/firebaseUserProperties.ts
@@ -0,0 +1,49 @@
+/**
+ * Firebase Analytics user properties and user id.
+ *
+ * Until now only PostHog and Crashlytics knew who a user was, so Firebase could not split
+ * retention by premium, widget owner or language. GA4 keeps a property until it is changed, so a
+ * value is sent only when it differs from the last one sent in this process.
+ *
+ * Each property used for a report must also be registered as a custom dimension in
+ * GA4 Admin → Custom definitions (User scope). Limits: name 24 characters, value 36.
+ */
+
+import { isAnalyticsAllowed } from './analyticsConsent';
+import { getAnalyticsModule } from './firebaseAnalytics';
+
+const MAX_VALUE_LENGTH = 36;
+
+const lastSent = new Map<string, string>();
+let lastUserId: string | null = null;
+
+/** GA4 user-property value for a JS value: booleans as 1/0 (like event params), cut to 36 chars. */
+export function toUserPropertyValue(value: string | number | boolean): string {
+  const text = typeof value === 'boolean' ? (value ? '1' : '0') : String(value);
+  return text.slice(0, MAX_VALUE_LENGTH);
+}
+
+export function setFirebaseUserProperties(
+  properties: Record<string, string | number | boolean | undefined>,
+): void {
+  if (!isAnalyticsAllowed()) return;
+  const changed: Record<string, string> = {};
+  for (const [name, value] of Object.entries(properties)) {
+    if (value === undefined) continue;
+    const text = toUserPropertyValue(value);
+    if (lastSent.get(name) !== text) changed[name] = text;
+  }
+  if (Object.keys(changed).length === 0) return;
+  const analytics = getAnalyticsModule();
+  if (!analytics) return;
+  for (const [name, text] of Object.entries(changed)) lastSent.set(name, text);
+  void analytics.setUserProperties(changed).catch(() => {});
+}
+
+export function setFirebaseUserId(id: string): void {
+  if (!isAnalyticsAllowed() || !id || id === lastUserId) return;
+  const analytics = getAnalyticsModule();
+  if (!analytics) return;
+  lastUserId = id;
+  void analytics.setUserId(id).catch(() => {});
+}
