new file mode 100644
index 0000000..40d67f0
--- /dev/null
+++ b/__tests__/widgetTelemetry.test.ts
@@ -0,0 +1,104 @@
+// A module (not a script), so its top-level names stay out of the other test files.
+export {};
+
+const mockLog = jest.fn();
+const mockSetProps = jest.fn();
+const mockInventory = jest.fn();
+const mockStale = jest.fn();
+
+jest.mock('../src/shared/analytics/analytics', () => ({
+  logAnalyticsEvent: (...a: unknown[]) => mockLog(...a),
+}));
+jest.mock('../src/shared/analytics/firebaseUserProperties', () => ({
+  setFirebaseUserProperties: (...a: unknown[]) => mockSetProps(...a),
+}));
+jest.mock('../src/shared/platform/widgetHealth', () => ({
+  STALE_AFTER_HOURS: 3,
+  readWidgetInventory: () => mockInventory(),
+  readWidgetStaleHours: () => mockStale(),
+}));
+jest.mock('react-native-device-info', () => ({
+  __esModule: true,
+  default: { getManufacturer: async () => 'Xiaomi' },
+}));
+
+const HOUR = 3_600_000;
+
+function load() {
+  let mod!: typeof import('../src/shared/platform/widgetTelemetry');
+  jest.isolateModules(() => {
+    mod = require('../src/shared/platform/widgetTelemetry');
+  });
+  return mod;
+}
+
+beforeEach(() => {
+  mockLog.mockReset();
+  mockSetProps.mockReset();
+  mockInventory.mockReset();
+  mockStale.mockReset();
+});
+
+describe('reportWidgetTelemetry', () => {
+  it('logs the inventory and sets the user properties', async () => {
+    mockInventory.mockResolvedValue({ kinds: ['day', 'year'], count: 2 });
+    mockStale.mockResolvedValue(null);
+    await load().reportWidgetTelemetry(10 * HOUR);
+    expect(mockSetProps).toHaveBeenCalledWith({ has_widget: true, widget_count: 2 });
+    expect(mockLog).toHaveBeenCalledWith(
+      'widget_inventory',
+      expect.objectContaining({ widget_count: 2, widget_types: 'day,year' }),
+    );
+  });
+
+  it('logs the inventory again only when it changes', async () => {
+    const { reportWidgetTelemetry } = load();
+    mockStale.mockResolvedValue(null);
+    mockInventory.mockResolvedValue({ kinds: ['day'], count: 1 });
+    await reportWidgetTelemetry(1 * HOUR);
+    await reportWidgetTelemetry(2 * HOUR);
+    mockInventory.mockResolvedValue({ kinds: ['day', 'life'], count: 2 });
+    await reportWidgetTelemetry(3 * HOUR);
+    const inventoryCalls = mockLog.mock.calls.filter(c => c[0] === 'widget_inventory');
+    expect(inventoryCalls).toHaveLength(2);
+  });
+
+  it('reports "none" for a phone with no widget, and never staleness', async () => {
+    mockInventory.mockResolvedValue({ kinds: [], count: 0 });
+    mockStale.mockResolvedValue(48);
+    await load().reportWidgetTelemetry(10 * HOUR);
+    expect(mockLog).toHaveBeenCalledWith(
+      'widget_inventory',
+      expect.objectContaining({ widget_count: 0, widget_types: 'none' }),
+    );
+    expect(mockLog.mock.calls.some(c => c[0] === 'widget_stale')).toBe(false);
+  });
+
+  it('does nothing when the native bridge cannot say', async () => {
+    mockInventory.mockResolvedValue(null);
+    await load().reportWidgetTelemetry(10 * HOUR);
+    expect(mockLog).not.toHaveBeenCalled();
+    expect(mockSetProps).not.toHaveBeenCalled();
+  });
+
+  it('reports widget_stale at 3+ hours with the manufacturer, at most every 6 hours', async () => {
+    const { reportWidgetTelemetry } = load();
+    mockInventory.mockResolvedValue({ kinds: ['day'], count: 1 });
+    mockStale.mockResolvedValue(2);
+    await reportWidgetTelemetry(10 * HOUR); // 2h: fresh enough
+    mockStale.mockResolvedValue(5);
+    await reportWidgetTelemetry(11 * HOUR); // 5h: reported
+    await reportWidgetTelemetry(12 * HOUR); // reported an hour ago: held back
+    await reportWidgetTelemetry(17 * HOUR + 1); // 6h later: reported again
+    const stale = mockLog.mock.calls.filter(c => c[0] === 'widget_stale');
+    expect(stale).toHaveLength(2);
+    expect(stale[0][1]).toEqual({ hours_stale: 5, manufacturer: 'xiaomi' });
+  });
+
+  it('stays quiet about staleness when the worker has never run', async () => {
+    mockInventory.mockResolvedValue({ kinds: ['day'], count: 1 });
+    mockStale.mockResolvedValue(null);
+    await load().reportWidgetTelemetry(10 * HOUR);
+    expect(mockLog.mock.calls.some(c => c[0] === 'widget_stale')).toBe(false);
+  });
+});
