@@ -0,0 +1,89 @@
+// A module (not a script), so its top-level names stay out of the other test files.
+export {};
+
+const mockSetUserProperties = jest.fn().mockResolvedValue(undefined);
+const mockSetUserId = jest.fn().mockResolvedValue(undefined);
+let mockAllowed = true;
+let mockModuleAvailable = true;
+
+jest.mock('../src/shared/analytics/analyticsConsent', () => ({
+  isAnalyticsAllowed: () => mockAllowed,
+}));
+jest.mock('../src/shared/analytics/firebaseAnalytics', () => ({
+  getAnalyticsModule: () =>
+    mockModuleAvailable
+      ? { setUserProperties: mockSetUserProperties, setUserId: mockSetUserId }
+      : null,
+}));
+
+function load() {
+  let mod!: typeof import('../src/shared/analytics/firebaseUserProperties');
+  jest.isolateModules(() => {
+    mod = require('../src/shared/analytics/firebaseUserProperties');
+  });
+  return mod;
+}
+
+beforeEach(() => {
+  mockSetUserProperties.mockClear();
+  mockSetUserId.mockClear();
+  mockAllowed = true;
+  mockModuleAvailable = true;
+});
+
+describe('setFirebaseUserProperties', () => {
+  it('sends booleans as 1/0 and cuts values to 36 characters', () => {
+    const { setFirebaseUserProperties } = load();
+    setFirebaseUserProperties({ is_premium: true, has_widget: false, onboarding_goal: 'x'.repeat(50) });
+    expect(mockSetUserProperties).toHaveBeenCalledWith({
+      is_premium: '1',
+      has_widget: '0',
+      onboarding_goal: 'x'.repeat(36),
+    });
+  });
+
+  it('sends only what changed since the last send', () => {
+    const { setFirebaseUserProperties } = load();
+    setFirebaseUserProperties({ app_language: 'en', is_premium: false });
+    setFirebaseUserProperties({ app_language: 'en', is_premium: true });
+    setFirebaseUserProperties({ app_language: 'en', is_premium: true });
+    expect(mockSetUserProperties).toHaveBeenCalledTimes(2);
+    expect(mockSetUserProperties).toHaveBeenLastCalledWith({ is_premium: '1' });
+  });
+
+  it('skips unknown (undefined) values', () => {
+    const { setFirebaseUserProperties } = load();
+    setFirebaseUserProperties({ reminders_on: undefined });
+    expect(mockSetUserProperties).not.toHaveBeenCalled();
+  });
+
+  it('sends nothing without analytics consent, then sends once consent is given', () => {
+    const { setFirebaseUserProperties } = load();
+    mockAllowed = false;
+    setFirebaseUserProperties({ is_premium: true });
+    expect(mockSetUserProperties).not.toHaveBeenCalled();
+    mockAllowed = true;
+    setFirebaseUserProperties({ is_premium: true });
+    expect(mockSetUserProperties).toHaveBeenCalledTimes(1);
+  });
+
+  it('is a no-op when Firebase is not configured', () => {
+    mockModuleAvailable = false;
+    expect(() => load().setFirebaseUserProperties({ is_premium: true })).not.toThrow();
+    expect(mockSetUserProperties).not.toHaveBeenCalled();
+  });
+});
+
+describe('setFirebaseUserId', () => {
+  it('sets the id once, and not without consent', () => {
+    const { setFirebaseUserId } = load();
+    mockAllowed = false;
+    setFirebaseUserId('abc');
+    expect(mockSetUserId).not.toHaveBeenCalled();
+    mockAllowed = true;
+    setFirebaseUserId('abc');
+    setFirebaseUserId('abc');
+    setFirebaseUserId('def');
+    expect(mockSetUserId.mock.calls).toEqual([['abc'], ['def']]);
+  });
+});
diff --git a/__tests__/notificationOpened.test.ts b/__tests__/notificationOpened.test.ts
