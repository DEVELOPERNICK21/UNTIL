@@ -0,0 +1,77 @@
+import {
+  AppStateSessionTracker,
+  SESSION_GAP_MS,
+} from '../src/features/engagement/services/appSessionTracker';
+
+function setup() {
+  let listener: (state: string) => void = () => {};
+  const appState = {
+    addEventListener: jest.fn((_type: 'change', fn: (state: string) => void) => {
+      listener = fn;
+      return { remove: jest.fn() };
+    }),
+  };
+  let clock = 1_000_000;
+  const tracker = new AppStateSessionTracker(appState, () => clock);
+  return {
+    tracker,
+    appState,
+    send: (state: string) => listener(state),
+    at: (ms: number) => {
+      clock = ms;
+    },
+  };
+}
+
+describe('AppStateSessionTracker', () => {
+  it('a cold start is a new session', () => {
+    expect(setup().tracker.noteForeground(1_000_000)).toBe(true);
+  });
+
+  it('coming back from the background within the gap is the same session', () => {
+    const { tracker, send, at } = setup();
+    tracker.noteForeground(1_000_000);
+    at(1_000_000);
+    send('background');
+    expect(tracker.noteForeground(1_000_000 + SESSION_GAP_MS - 1)).toBe(false);
+  });
+
+  it('coming back after the gap is a new session', () => {
+    const { tracker, send, at } = setup();
+    tracker.noteForeground(1_000_000);
+    at(1_000_000);
+    send('background');
+    expect(tracker.noteForeground(1_000_000 + SESSION_GAP_MS)).toBe(true);
+  });
+
+  it('inactive (shade, permission dialog, purchase sheet) never ends a session', () => {
+    const { tracker, send } = setup();
+    tracker.noteForeground(1_000_000);
+    send('inactive');
+    expect(tracker.noteForeground(1_000_000 + 10 * SESSION_GAP_MS)).toBe(false);
+  });
+
+  it('a foreground with no background before it is the same session', () => {
+    const { tracker } = setup();
+    tracker.noteForeground(1_000_000);
+    expect(tracker.noteForeground(1_000_500)).toBe(false);
+  });
+
+  it('measures each gap from its own background event', () => {
+    const { tracker, send, at } = setup();
+    tracker.noteForeground(0);
+    at(0);
+    send('background');
+    expect(tracker.noteForeground(SESSION_GAP_MS)).toBe(true);
+    at(SESSION_GAP_MS + 10);
+    send('background');
+    expect(tracker.noteForeground(SESSION_GAP_MS + 60_000)).toBe(false);
+  });
+
+  it('listens to the OS once', () => {
+    const { tracker, appState } = setup();
+    tracker.noteForeground(1);
+    tracker.noteForeground(2);
+    expect(appState.addEventListener).toHaveBeenCalledTimes(1);
+  });
+});
