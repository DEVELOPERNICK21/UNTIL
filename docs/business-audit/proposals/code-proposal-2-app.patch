+import { shouldAliasToAccount } from '../src/shared/analytics/posthogClient';
+
+// posthogClient reads the analytics consent from MMKV; the decision under test does not need it.
+jest.mock('../src/shared/analytics/analyticsConsent', () => ({
+  isAnalyticsAllowed: () => true,
+  subscribeAnalyticsConsent: () => () => {},
+}));
+
+describe('shouldAliasToAccount', () => {
+  it('links the account id when this device was already known by its device id', () => {
+    expect(shouldAliasToAccount('device-1', 'device-1', 'uid-9')).toBe(true);
+  });
+
+  it('does not alias on a cold start with an account already signed in', () => {
+    expect(shouldAliasToAccount(null, 'device-1', 'uid-9')).toBe(false);
+  });
+
+  it('does not alias when signing out, or when there is no account', () => {
+    expect(shouldAliasToAccount('uid-9', 'device-1', null)).toBe(false);
+    expect(shouldAliasToAccount('device-1', 'device-1', null)).toBe(false);
+  });
+
+  it('does not alias an id to itself, or switch between two accounts', () => {
+    expect(shouldAliasToAccount('device-1', 'device-1', 'device-1')).toBe(false);
+    expect(shouldAliasToAccount('uid-1', 'device-1', 'uid-2')).toBe(false);
+  });
+});
