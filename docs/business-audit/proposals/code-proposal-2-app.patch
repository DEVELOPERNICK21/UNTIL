+/**
+ * True when this person was known by their device id in this session and has just signed in:
+ * PostHog treats `identify(accountId)` after `identify(deviceId)` as a second person, so the
+ * account id must be aliased to the device id first. Not needed on a cold start with an account
+ * already signed in (nothing earlier in this session to link).
+ */
+export function shouldAliasToAccount(
+  previousDistinctId: string | null,
+  deviceId: string,
+  accountId: string | null,
+): boolean {
+  return accountId != null && previousDistinctId === deviceId && accountId !== deviceId;
+}
+
+export function aliasPostHogUser(accountId: string): void {
+  const client = getPostHogClient();
+  if (!client || !isAnalyticsAllowed()) return;
+  try {
+    client.alias(accountId);
+  } catch {
+    /* best-effort */
+  }
+}
+
