diff --git a/src/shared/platform/notificationOpened.ts b/src/shared/platform/notificationOpened.ts
new file mode 100644
index 0000000..ced1c18
--- /dev/null
+++ b/src/shared/platform/notificationOpened.ts
@@ -0,0 +1,112 @@
+/**
+ * `notification_opened`: which reminder brought someone back.
+ *
+ * Notifee delivers a tap three ways: a foreground event (app open), a background event (app
+ * alive but backgrounded; the handler must be registered at startup, before React renders) and
+ * getInitialNotification (the tap that started the app from closed). Each reports once.
+ * Notifee is loaded lazily and every call is best-effort, like the rest of the notification code.
+ */
+
+import { logAnalyticsEvent } from '../analytics/analytics';
+
+export type NotificationKind =
+  | 'retention'
+  | 'winback'
+  | 'task'
+  | 'streak'
+  | 'trial'
+  | 'day2'
+  | 'other';
+
+type NotificationLike = { id?: string; data?: Record<string, unknown> } | undefined;
+type OpenSource = 'foreground' | 'background' | 'launch';
+
+/** Kind from the notification's `data.type` when set, else from its id prefix. */
+export function notificationKindOf(notification: NotificationLike): NotificationKind {
+  const type = notification?.data?.type;
+  if (type === 'retention' || type === 'winback') return type;
+  const id = notification?.id ?? '';
+  if (id.startsWith('retention-')) return 'retention';
+  if (id.startsWith('taskdl-')) return 'task';
+  if (id.startsWith('presence-saver-')) return 'streak';
+  if (id === 'trial' || id.startsWith('trial-')) return 'trial';
+  if (id === 'engagement-day2') return 'day2';
+  return 'other';
+}
+
+export function logNotificationOpened(
+  notification: NotificationLike,
+  source: OpenSource,
+): void {
+  void logAnalyticsEvent('notification_opened', {
+    type: notificationKindOf(notification),
+    source,
+  });
+}
+
+type NotifeeEvent = {
+  type: number;
+  detail?: { notification?: { id?: string; data?: Record<string, unknown> } };
+};
+
+function loadNotifee(): {
+  notifee: {
+    onForegroundEvent: (handler: (event: NotifeeEvent) => void) => () => void;
+    onBackgroundEvent: (handler: (event: NotifeeEvent) => Promise<void>) => void;
+    getInitialNotification: () => Promise<{
+      notification?: { id?: string; data?: Record<string, unknown> };
+    } | null>;
+  };
+  pressType: number;
+} | null {
+  try {
+    const mod = require('@notifee/react-native');
+    return { notifee: mod.default, pressType: mod.EventType.PRESS };
+  } catch {
+    return null;
+  }
+}
+
+/** Call once at startup, outside React (index.js). Taps while the app is backgrounded land here. */
+export function registerNotificationBackgroundHandler(): void {
+  const loaded = loadNotifee();
+  if (!loaded) return;
+  try {
+    loaded.notifee.onBackgroundEvent(async event => {
+      if (event.type === loaded.pressType) {
+        logNotificationOpened(event.detail?.notification, 'background');
+      }
+    });
+  } catch {
+    /* Notifee unavailable */
+  }
+}
+
+let launchChecked = false;
+
+/**
+ * Reports taps made while the app is open and, once per process, the tap that launched it.
+ * Returns the unsubscribe function.
+ */
+export function subscribeNotificationOpened(): () => void {
+  const loaded = loadNotifee();
+  if (!loaded) return () => {};
+  try {
+    if (!launchChecked) {
+      launchChecked = true;
+      void loaded.notifee
+        .getInitialNotification()
+        .then(initial => {
+          if (initial?.notification) logNotificationOpened(initial.notification, 'launch');
+        })
+        .catch(() => {});
+    }
+    return loaded.notifee.onForegroundEvent(event => {
+      if (event.type === loaded.pressType) {
+        logNotificationOpened(event.detail?.notification, 'foreground');
+      }
+    });
+  } catch {
+    return () => {};
+  }
+}
diff --git a/src/shared/platform/widgetHealth.ts b/src/shared/platform/widgetHealth.ts
new file mode 100644
index 0000000..cf8b1b6
--- /dev/null
+++ b/src/shared/platform/widgetHealth.ts
@@ -0,0 +1,79 @@
+/**
+ * What is on the home screen, and whether Android's background refresh is keeping up.
+ *
+ * Reads the native WidgetBridge: `getWidgetStatus` on Android (AppWidgetManager) and iOS
+ * (WidgetCenter.getCurrentConfigurations), `getWidgetHealth` on Android only. Every read is
+ * best-effort and returns null when the bridge or the method is missing, so an older native build
+ * simply reports nothing.
+ */
+
+import { NativeModules, Platform } from 'react-native';
+import { MS_PER_HOUR } from '../time/constants';
+
+/** Native status field → the short kind name used in analytics. */
+const KIND_BY_FIELD: Record<string, string> = {
+  dayWidgetAdded: 'day',
+  monthWidgetAdded: 'month',
+  yearWidgetAdded: 'year',
+  lifeWidgetAdded: 'life',
+  counterWidgetAdded: 'counter',
+  countdownWidgetAdded: 'countdown',
+  dailyTasksWidgetAdded: 'daily_tasks',
+  hourCalculationWidgetAdded: 'hour_calc',
+};
+
+export type WidgetInventory = {
+  /** Kinds with at least one widget placed, sorted. A kind counts once however many are placed. */
+  kinds: string[];
+  count: number;
+};
+
+/** Hours of staleness at or above which `widget_stale` is reported. */
+export const STALE_AFTER_HOURS = 3;
+
+type WidgetBridgeShape = {
+  getWidgetStatus?: () => Promise<Record<string, boolean | undefined>>;
+  getWidgetHealth?: () => Promise<{ lastBackgroundRefreshMs?: number | null }>;
+};
+
+function bridge(): WidgetBridgeShape | undefined {
+  return NativeModules.WidgetBridge;
+}
+
+export function inventoryFromStatus(
+  status: Record<string, boolean | undefined>,
+): WidgetInventory {
+  const kinds = Object.entries(KIND_BY_FIELD)
+    .filter(([field]) => status[field] === true)
+    .map(([, kind]) => kind)
+    .sort();
+  return { kinds, count: kinds.length };
+}
+
+export async function readWidgetInventory(): Promise<WidgetInventory | null> {
+  try {
+    const status = await bridge()?.getWidgetStatus?.();
+    return status ? inventoryFromStatus(status) : null;
+  } catch {
+    return null;
+  }
+}
+
+/** Whole hours between the last background refresh and `now`, or null when unknown. */
+export function hoursSince(lastMs: number | null | undefined, now: number): number | null {
+  if (typeof lastMs !== 'number' || !Number.isFinite(lastMs) || lastMs <= 0) return null;
+  return Math.max(0, Math.floor((now - lastMs) / MS_PER_HOUR));
+}
+
+/** Android only: hours since WorkManager last refreshed the widgets in the background. */
+export async function readWidgetStaleHours(
+  now: number = Date.now(),
+): Promise<number | null> {
+  if (Platform.OS !== 'android') return null;
+  try {
+    const health = await bridge()?.getWidgetHealth?.();
+    return hoursSince(health?.lastBackgroundRefreshMs, now);
+  } catch {
+    return null;
+  }
+}
diff --git a/src/shared/platform/widgetTelemetry.ts b/src/shared/platform/widgetTelemetry.ts
new file mode 100644
index 0000000..a1ea882
--- /dev/null
+++ b/src/shared/platform/widgetTelemetry.ts
@@ -0,0 +1,66 @@
+/**
+ * Widget activation and reliability telemetry, run at app start and on each return to the
+ * foreground. The home-screen widget is the product's strongest retention signal, and Firebase
+ * could not see whether anyone had one.
+ *
+ * - `widget_inventory`: logged when the set of widget kinds changes (and once per launch).
+ *   `has_widget` and `widget_count` also go out as Firebase user properties so every report can be
+ *   split by them.
+ * - `widget_stale` (Android): the periodic background refresh last ran 3+ hours ago while a widget
+ *   is on the screen. Phones that defer WorkManager (Doze, aggressive battery managers) show up
+ *   here by manufacturer. At most once every 6 hours.
+ */
+
+import { Platform } from 'react-native';
+import { logAnalyticsEvent } from '../analytics/analytics';
+import { setFirebaseUserProperties } from '../analytics/firebaseUserProperties';
+import { MS_PER_HOUR } from '../time/constants';
+import {
+  STALE_AFTER_HOURS,
+  readWidgetInventory,
+  readWidgetStaleHours,
+} from './widgetHealth';
+
+const STALE_LOG_EVERY_MS = 6 * MS_PER_HOUR;
+
+let lastInventoryKey: string | null = null;
+let lastStaleLoggedAt = 0;
+
+async function manufacturer(): Promise<string> {
+  try {
+    const DeviceInfo = require('react-native-device-info').default;
+    const name = await DeviceInfo?.getManufacturer?.();
+    return typeof name === 'string' && name ? name.toLowerCase() : 'unknown';
+  } catch {
+    return 'unknown';
+  }
+}
+
+export async function reportWidgetTelemetry(now: number = Date.now()): Promise<void> {
+  const inventory = await readWidgetInventory();
+  if (!inventory) return;
+
+  setFirebaseUserProperties({
+    has_widget: inventory.count > 0,
+    widget_count: inventory.count,
+  });
+
+  const key = inventory.kinds.join(',');
+  if (key !== lastInventoryKey) {
+    lastInventoryKey = key;
+    void logAnalyticsEvent('widget_inventory', {
+      widget_count: inventory.count,
+      widget_types: key || 'none',
+      platform: Platform.OS,
+    });
+  }
+
+  if (inventory.count === 0 || now - lastStaleLoggedAt < STALE_LOG_EVERY_MS) return;
+  const hours = await readWidgetStaleHours(now);
+  if (hours == null || hours < STALE_AFTER_HOURS) return;
+  lastStaleLoggedAt = now;
+  void logAnalyticsEvent('widget_stale', {
+    hours_stale: hours,
+    manufacturer: await manufacturer(),
+  });
+}
