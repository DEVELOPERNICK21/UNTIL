+import { hoursSince, inventoryFromStatus } from '../src/shared/platform/widgetHealth';
+
+const HOUR = 3_600_000;
+
+describe('inventoryFromStatus', () => {
+  it('lists the kinds that exist, sorted, and counts kinds', () => {
+    expect(
+      inventoryFromStatus({
+        yearWidgetAdded: true,
+        dayWidgetAdded: true,
+        monthWidgetAdded: false,
+        dailyTasksWidgetAdded: true,
+      }),
+    ).toEqual({ kinds: ['daily_tasks', 'day', 'year'], count: 3 });
+  });
+
+  it('ignores unknown fields and missing values', () => {
+    expect(inventoryFromStatus({ somethingElse: true, lifeWidgetAdded: undefined })).toEqual({
+      kinds: [],
+      count: 0,
+    });
+  });
+});
+
+describe('hoursSince', () => {
+  it('is whole hours, rounded down', () => {
+    expect(hoursSince(0 + 1, 1 + 3 * HOUR + 59 * 60_000)).toBe(3);
+  });
+
+  it('is null when the worker has never run or the value is junk', () => {
+    expect(hoursSince(null, 5 * HOUR)).toBeNull();
+    expect(hoursSince(undefined, 5 * HOUR)).toBeNull();
+    expect(hoursSince(0, 5 * HOUR)).toBeNull();
+    expect(hoursSince(NaN, 5 * HOUR)).toBeNull();
+  });
+
+  it('never goes negative if the clock moved back', () => {
+    expect(hoursSince(10 * HOUR, 5 * HOUR)).toBe(0);
+  });
+});
