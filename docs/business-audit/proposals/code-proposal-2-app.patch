@@ -0,0 +1,100 @@
+// A module (not a script), so its top-level names stay out of the other test files.
+export {};
+
+const mockLog = jest.fn();
+jest.mock('../src/shared/analytics/analytics', () => ({
+  logAnalyticsEvent: (...a: unknown[]) => mockLog(...a),
+}));
+
+const PRESS = 1;
+const mockNotifee = {
+  onForegroundEvent: jest.fn(),
+  onBackgroundEvent: jest.fn(),
+  getInitialNotification: jest.fn(),
+};
+jest.mock('@notifee/react-native', () => ({
+  __esModule: true,
+  default: mockNotifee,
+  EventType: { PRESS: 1, DISMISSED: 0 },
+}));
+
+function load() {
+  let mod!: typeof import('../src/shared/platform/notificationOpened');
+  jest.isolateModules(() => {
+    mod = require('../src/shared/platform/notificationOpened');
+  });
+  return mod;
+}
+
+beforeEach(() => {
+  mockLog.mockReset();
+  mockNotifee.onForegroundEvent.mockReset().mockReturnValue(jest.fn());
+  mockNotifee.onBackgroundEvent.mockReset();
+  mockNotifee.getInitialNotification.mockReset().mockResolvedValue(null);
+});
+
+describe('notificationKindOf', () => {
+  const { notificationKindOf } = load();
+
+  it('uses data.type when the schedule set it', () => {
+    expect(notificationKindOf({ id: 'retention-2026-06-01', data: { type: 'winback' } })).toBe('winback');
+    expect(notificationKindOf({ id: 'x', data: { type: 'retention' } })).toBe('retention');
+  });
+
+  it('falls back to the id prefix of each scheduler', () => {
+    expect(notificationKindOf({ id: 'retention-2026-06-01' })).toBe('retention');
+    expect(notificationKindOf({ id: 'taskdl-tasks-2026-06-01' })).toBe('task');
+    expect(notificationKindOf({ id: 'taskdl-dl-am-abc-2026-06-01' })).toBe('task');
+    expect(notificationKindOf({ id: 'presence-saver-2026-06-01' })).toBe('streak');
+    expect(notificationKindOf({ id: 'trial-reminder-day-4' })).toBe('trial');
+    expect(notificationKindOf({ id: 'trial' })).toBe('trial');
+    expect(notificationKindOf({ id: 'engagement-day2' })).toBe('day2');
+  });
+
+  it('is "other" for anything it does not know, including nothing', () => {
+    expect(notificationKindOf({ id: 'something-new' })).toBe('other');
+    expect(notificationKindOf(undefined)).toBe('other');
+  });
+});
+
+describe('subscribeNotificationOpened', () => {
+  it('reports a tap made while the app is open, and ignores other events', () => {
+    load().subscribeNotificationOpened();
+    const handler = mockNotifee.onForegroundEvent.mock.calls[0][0];
+    handler({ type: 0, detail: { notification: { id: 'retention-x' } } });
+    handler({ type: PRESS, detail: { notification: { id: 'taskdl-done-2026-06-01' } } });
+    expect(mockLog).toHaveBeenCalledTimes(1);
+    expect(mockLog).toHaveBeenCalledWith('notification_opened', { type: 'task', source: 'foreground' });
+  });
+
+  it('reports the tap that launched the app, once per process', async () => {
+    const { subscribeNotificationOpened } = load();
+    mockNotifee.getInitialNotification.mockResolvedValue({
+      notification: { id: 'retention-2026-06-02', data: { type: 'winback' } },
+    });
+    subscribeNotificationOpened();
+    subscribeNotificationOpened();
+    await Promise.resolve();
+    await Promise.resolve();
+    expect(mockNotifee.getInitialNotification).toHaveBeenCalledTimes(1);
+    expect(mockLog).toHaveBeenCalledWith('notification_opened', { type: 'winback', source: 'launch' });
+  });
+
+  it('returns the unsubscribe function from Notifee', () => {
+    const unsubscribe = jest.fn();
+    mockNotifee.onForegroundEvent.mockReturnValue(unsubscribe);
+    load().subscribeNotificationOpened()();
+    expect(unsubscribe).toHaveBeenCalled();
+  });
+});
+
+describe('registerNotificationBackgroundHandler', () => {
+  it('reports a tap that arrives while the app is in the background', async () => {
+    load().registerNotificationBackgroundHandler();
+    const handler = mockNotifee.onBackgroundEvent.mock.calls[0][0];
+    await handler({ type: PRESS, detail: { notification: { id: 'presence-saver-2026-06-01' } } });
+    await handler({ type: 0, detail: { notification: { id: 'presence-saver-2026-06-01' } } });
+    expect(mockLog).toHaveBeenCalledTimes(1);
+    expect(mockLog).toHaveBeenCalledWith('notification_opened', { type: 'streak', source: 'background' });
+  });
+});
