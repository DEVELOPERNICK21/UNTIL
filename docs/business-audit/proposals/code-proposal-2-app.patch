diff --git a/src/features/engagement/services/appSessionTracker.ts b/src/features/engagement/services/appSessionTracker.ts
new file mode 100644
index 0000000..70a2e39
--- /dev/null
+++ b/src/features/engagement/services/appSessionTracker.ts
@@ -0,0 +1,48 @@
+/**
+ * App session boundaries from the OS app state. A session starts on a cold start, or when the app
+ * returns after at least SESSION_GAP_MS in the background. Kept in memory: a new process is a new
+ * session, which is what a person who closed the app and opened it again would call it.
+ *
+ * Only 'background' counts as leaving. On iOS 'inactive' fires for the notification shade,
+ * permission dialogs and the purchase sheet, none of which end a session.
+ */
+
+import { AppState } from 'react-native';
+import { MS_PER_MINUTE } from '../../../shared/time/constants';
+import type { IAppSessionTracker } from '../domain/ports/IAppSessionTracker';
+
+export const SESSION_GAP_MS = 30 * MS_PER_MINUTE;
+
+type AppStateSource = {
+  addEventListener: (type: 'change', listener: (state: string) => void) => unknown;
+};
+
+export class AppStateSessionTracker implements IAppSessionTracker {
+  private backgroundedAt: number | null = null;
+  private seenForeground = false;
+  private listening = false;
+
+  constructor(
+    private readonly appState: AppStateSource = AppState,
+    private readonly clock: () => number = Date.now,
+  ) {}
+
+  noteForeground(now: number): boolean {
+    this.listen();
+    if (!this.seenForeground) {
+      this.seenForeground = true;
+      return true;
+    }
+    const left = this.backgroundedAt;
+    this.backgroundedAt = null;
+    return left != null && now - left >= SESSION_GAP_MS;
+  }
+
+  private listen(): void {
+    if (this.listening) return;
+    this.listening = true;
+    this.appState.addEventListener('change', state => {
+      if (state === 'background') this.backgroundedAt = this.clock();
+    });
+  }
+}
