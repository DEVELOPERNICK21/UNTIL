+import { TrackAppOpenUseCase } from '../src/features/engagement/domain/useCases/TrackAppOpenUseCase';
+import { LIFE_EVENT_UNLOCK_MS } from '../src/config/accessConstants';
+
+const DAY = 86_400_000;
+
+function fakeRepo(initial: { count?: number; trialStart?: number | null } = {}) {
+  const state = {
+    count: initial.count ?? 0,
+    trialStart: initial.trialStart ?? null,
+    lifeUnlockUntil: null as number | null,
+  };
+  const repo = {
+    getTrialStartDate: () => state.trialStart,
+    setTrialStartDate: (ms: number | null) => {
+      state.trialStart = ms;
+    },
+    getAppOpenCount: () => state.count,
+    incrementAppOpenCount: () => ++state.count,
+    setLifeUnlockUntil: (ms: number | null) => {
+      state.lifeUnlockUntil = ms;
+    },
+  };
+  return { repo: repo as never, state };
+}
+
+const sessions = (answers: boolean[]) => {
+  const queue = [...answers];
+  return { noteForeground: jest.fn(() => queue.shift() ?? false) };
+};
+
+describe('TrackAppOpenUseCase with sessions', () => {
+  it('counts a foreground only when it starts a session', () => {
+    const { repo, state } = fakeRepo();
+    const useCase = new TrackAppOpenUseCase(repo, undefined, sessions([true, false, false, true]));
+    for (let i = 0; i < 4; i += 1) useCase.execute(1_000 + i);
+    expect(state.count).toBe(2);
+  });
+
+  it('without a tracker every foreground counts, as before', () => {
+    const { repo, state } = fakeRepo();
+    const useCase = new TrackAppOpenUseCase(repo);
+    useCase.execute(1);
+    useCase.execute(2);
+    useCase.execute(3);
+    expect(state.count).toBe(3);
+  });
+
+  it('starts the preview clock on the very first open only', () => {
+    const { repo, state } = fakeRepo();
+    const useCase = new TrackAppOpenUseCase(repo, undefined, sessions([true, true]));
+    useCase.execute(5_000);
+    useCase.execute(9_000);
+    expect(state.trialStart).toBe(5_000);
+  });
+
+  it('unlocks Life for 24h from the third session and keeps refreshing it on later foregrounds', () => {
+    const { repo, state } = fakeRepo({ count: 2, trialStart: 0 });
+    const useCase = new TrackAppOpenUseCase(repo, undefined, sessions([false, true, false]));
+    useCase.execute(10); // still session 2: nothing yet
+    expect(state.lifeUnlockUntil).toBeNull();
+    useCase.execute(20); // third session
+    expect(state.lifeUnlockUntil).toBe(20 + LIFE_EVENT_UNLOCK_MS);
+    useCase.execute(30); // a quick return keeps the window fresh
+    expect(state.lifeUnlockUntil).toBe(30 + LIFE_EVENT_UNLOCK_MS);
+  });
+
+  it('reports each new session with its number and the days since the first open', () => {
+    const { repo } = fakeRepo({ count: 4, trialStart: 0 });
+    const onNewSession = jest.fn();
+    const useCase = new TrackAppOpenUseCase(repo, undefined, sessions([true, false]), onNewSession);
+    useCase.execute(3 * DAY + 5);
+    useCase.execute(3 * DAY + 10);
+    expect(onNewSession).toHaveBeenCalledTimes(1);
+    expect(onNewSession).toHaveBeenCalledWith({ sessionIndex: 5, daysSinceInstall: 3 });
+  });
+
+  it('the first ever session is day 0', () => {
+    const { repo } = fakeRepo();
+    const onNewSession = jest.fn();
+    new TrackAppOpenUseCase(repo, undefined, sessions([true]), onNewSession).execute(777);
+    expect(onNewSession).toHaveBeenCalledWith({ sessionIndex: 1, daysSinceInstall: 0 });
+  });
+});
