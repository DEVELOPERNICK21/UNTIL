@@ -0,0 +1,31 @@
+package app.until.time
+
+import android.content.Context
+
+/**
+ * When the periodic background refresh (UNTILWidgetWorker) last ran. The JS side reads it through
+ * WidgetBridge.getWidgetHealth to report `widget_stale`: phones whose battery manager defers
+ * WorkManager show up as a growing gap. Only the periodic worker records it; a refresh the app
+ * itself asks for at launch would always look fresh.
+ */
+object WidgetHealth {
+    private const val PREFS = "until_widget_health"
+    private const val KEY_LAST_BACKGROUND_REFRESH = "last_background_refresh_ms"
+
+    fun recordBackgroundRefresh(context: Context, nowMs: Long = System.currentTimeMillis()) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit()
+            .putLong(KEY_LAST_BACKGROUND_REFRESH, nowMs)
+            .apply()
+    }
+
+    /** Milliseconds since the epoch, or null if the worker has not run yet. */
+    fun lastBackgroundRefreshMs(context: Context): Long? {
+        val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        return if (prefs.contains(KEY_LAST_BACKGROUND_REFRESH)) {
+            prefs.getLong(KEY_LAST_BACKGROUND_REFRESH, 0L)
+        } else {
+            null
+        }
+    }
+}
