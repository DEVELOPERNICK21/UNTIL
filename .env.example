# PostHog — copy to .env and fill in your Project API Key (phc_...)
# Project settings: https://us.posthog.com/project/472860/settings
UNTIL_POSTHOG_API_KEY=
UNTIL_POSTHOG_HOST=https://us.i.posthog.com
# Set to 1 so events send while running yarn ios / yarn android (__DEV__)
UNTIL_POSTHOG_DEV=1
# Firebase Google Sign-In — Web client ID (client_type 3 in google-services.json)
UNTIL_GOOGLE_WEB_CLIENT_ID=
