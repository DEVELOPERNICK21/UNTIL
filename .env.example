# PostHog — copy to .env and fill in your Project API Key (phc_...)
# Project settings: https://us.posthog.com/project/472860/settings
UNTIL_POSTHOG_API_KEY=
UNTIL_POSTHOG_HOST=https://us.i.posthog.com
# Set to 1 so events send while running yarn ios / yarn android (__DEV__)
UNTIL_POSTHOG_DEV=1
# Firebase Google Sign-In — Web client ID (client_type 3 in google-services.json)
# Example for until-b7624: 150745476537-l5sr6mf0ma7le6qqgk88387fmhgc6p3a.apps.googleusercontent.com
# Required for release AABs. Local .env must be present when running yarn android:release-aab.
UNTIL_GOOGLE_WEB_CLIENT_ID=
# RevenueCat public SDK keys (never secret keys).
# iOS release / TestFlight / App Store: appl_… (never test_ — RC crashes release builds).
# Android release: goog_…
# Local simulated IAP only: test_… in __DEV__ builds.
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=
