<?xml version="1.0" encoding="utf-8"?>
<!-- Month widget: caption → dots → big % → days left → thin bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_progress_background"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/widget_month_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:textColor="#8A8A8E"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:text="MONTH" />

    <ImageView
        android:id="@+id/widget_month_dots"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:scaleType="centerInside"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_month_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="#E87C20"
        android:textSize="30sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="0%" />

    <TextView
        android:id="@+id/widget_month_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="1dp"
        android:textColor="#8A8A8E"
        android:textSize="11sp"
        android:text="of month" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_month_passed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="0d passed" />

        <TextView
            android:id="@+id/widget_month_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F2F2F2"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="30d left" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_month_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#E87C20"
        android:progressBackgroundTint="#3A342F" />
</LinearLayout>
