<?xml version="1.0" encoding="utf-8"?>
<!-- Tasks: the donut is the share done, the number is the count. Nothing repeats them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_daily_tasks_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_label"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:text="TASKS" />

        <ImageView
            android:id="@+id/widget_daily_tasks_ember"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_daily_tasks_pie"
            android:src="@drawable/widget_preview_tasks"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_daily_tasks_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_hero"
                android:textSize="26sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0/0" />

            <TextView
                android:id="@+id/widget_daily_tasks_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/widget_label"
                android:textSize="12sp"
                android:maxLines="1"
                android:text="done" />
        </LinearLayout>
    </LinearLayout>

    <!-- Category lines only show if the widget is resized tall enough; otherwise clipped. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_daily_tasks_cat1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/widget_label"
            android:textSize="11sp"
            android:maxLines="1"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_daily_tasks_cat2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_label"
            android:textSize="11sp"
            android:maxLines="1"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_daily_tasks_cat3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_label"
            android:textSize="11sp"
            android:maxLines="1"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_daily_tasks_cat4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_label"
            android:textSize="11sp"
            android:maxLines="1"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_daily_tasks_cat5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_label"
            android:textSize="11sp"
            android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
