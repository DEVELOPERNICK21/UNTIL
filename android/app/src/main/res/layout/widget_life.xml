<?xml version="1.0" encoding="utf-8"?>
<!-- Life: years left up top, one dot per year below, the plan length as the only footnote. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/widget_life_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_label"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:text="YOUR LIFE" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/widget_life_years"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_hero"
            android:textSize="44sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="0" />

        <TextView
            android:id="@+id/widget_life_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/widget_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="years left" />
    </LinearLayout>

    <!-- fitCenter without adjustViewBounds keeps the dots centered in the
         flexible area instead of pinning them to the top with dead space. -->
    <ImageView
        android:id="@+id/widget_life_dots"
            android:src="@drawable/widget_preview_life"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_life_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/widget_label"
        android:textSize="12sp"
        android:maxLines="3"
        android:text="of 80 years" />
</LinearLayout>
