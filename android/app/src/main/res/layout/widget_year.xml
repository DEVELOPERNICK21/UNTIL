<?xml version="1.0" encoding="utf-8"?>
<!-- Year: days left up top, the 365 dots are the progress. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/widget_year_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_label"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:text="2026" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/widget_year_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_hero"
            android:textSize="44sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="365" />

        <TextView
            android:id="@+id/widget_year_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/widget_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="days left" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_year_dots"
            android:src="@drawable/widget_preview_year"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />
</LinearLayout>
