<?xml version="1.0" encoding="utf-8"?>
<!-- Counter: name, the count, and a "+" that shows what a tap does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_counter_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_hero"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Counter" />

    <TextView
        android:id="@+id/widget_counter_count"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:textColor="@color/widget_hero"
        android:textSize="54sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:text="0" />

    <TextView
        android:id="@+id/widget_counter_plus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="end"
        android:background="@drawable/widget_plus_badge"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+"
        android:textColor="#D9000000"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
