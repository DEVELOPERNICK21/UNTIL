<?xml version="1.0" encoding="utf-8"?>
<!-- Month/Year shared surface: warm dark glass + clear rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#2A2420"
        android:centerColor="#161412"
        android:endColor="#0C0B0A"
        android:type="linear" />
    <corners android:radius="@dimen/widget_corner_radius" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
