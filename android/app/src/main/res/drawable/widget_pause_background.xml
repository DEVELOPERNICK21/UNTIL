<?xml version="1.0" encoding="utf-8"?>
<!-- The calm teal of the Pause screen, so the doorway looks like the room behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#0E343C"
        android:centerColor="#0A222B"
        android:endColor="#06141A"
        android:type="linear" />
    <corners android:radius="@dimen/widget_corner_radius" />
    <stroke
        android:width="1dp"
        android:color="#332FB6B0" />
</shape>
